    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json=pm.response.json();\r",
              "pm.environment.set(\"ID\",json.bookingid)\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "pm.test(\"Verify first name of user\",()=>{\r",
              "    pm.expect(json.booking.firstname).to.eql(pm.environment.get(\"First_Name\"));\r",
              "})\r",
              "pm.test(\"Verify the last name of user\", () => {\r",
              "    pm.expect(json.booking.lastname).to.eql(pm.environment.get(\"Last_Name\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Verify the total price\", () => {\r",
              "    pm.expect(json.booking.totalprice).to.eql(Number(pm.environment.get(\"Total_Price\")));\r",
              "});\r",
              "\r",
              "if(pm.response.code===201){\r",
              "    console.log(\"Booking got created successfully with booking Id: \"+json.booking.id)\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
