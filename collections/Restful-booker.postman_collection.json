    {
      "name": "Generate Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json=pm.response.json();\r",
              "pm.environment.set(\"token\",json.token)\r",
              "\r",
              "pm.test(\"Verify token generation\",function(){\r",
              "    pm.expect(json.token).to.not.be.null\r",
              "})\r",
              "pm.test(\"Verify status code\",function(){\r",
              "    pm.expect(pm.response.code).to.eql(200)\r",
              "})\r",
